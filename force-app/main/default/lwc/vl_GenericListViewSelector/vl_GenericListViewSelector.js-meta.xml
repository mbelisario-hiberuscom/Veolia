<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
	<apiVersion>65.0</apiVersion>
	<isExposed>true</isExposed>
	<masterLabel>Generic List View Selector</masterLabel>
	<description>Reusable list view table for any configured Salesforce object.</description>
	<targets>
		<target>lightning__AppPage</target>
		<target>lightning__RecordPage</target>
		<target>lightning__HomePage</target>
		<target>lightningCommunity__Page</target>
		<target>lightningCommunity__Default</target>
	</targets>
	<targetConfigs>
		<targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage,lightningCommunity__Default">
			<property name="objectApiName" type="String" label="Object API Name" required="true" />
			<property name="newRecordFlowApiName" type="String" label="New Record Screen Flow API Name" />
			<property name="icon" type="String" label="Header Icon" />
			<property name="title" type="String" label="Header Title" />
			<property name="subtitle" type="String" label="Header Subtitle" />
			<property name="showRecentlyViewedRecords" type="Boolean" label="Show Recently Viewed Records" default="true" />
			<property name="recentlyViewedRecordLimit" type="Integer" label="Recently Viewed Record Limit" default="5" />
			<property name="recentlyViewedFieldApiNames" type="String" label="Recently Viewed Fields" />
		</targetConfig>
	</targetConfigs>
</LightningComponentBundle>